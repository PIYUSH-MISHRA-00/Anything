<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules (IS-P04).

  Anything is local-first: an Experience, the knowledge cache and the activity
  log exist only on the device that made them. Two reasons to exclude
  everything rather than accept the platform default:

    1. `CredentialVault` stores an AI provider API key. A key leaving the
       device inside a cloud backup is a credential-exfiltration path nobody
       reviewed.
    2. `SqliteExperienceRepository` holds generated software. Restoring it onto
       a different device would resurrect Experiences whose protection seeds
       and capability grants were issued for the original device.

  Export/import (IS-P02) is the deliberate, user-initiated way to move an
  Experience between devices. That path is auditable; a silent cloud backup is
  not.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
