<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions (IS-P01) ───────────────────────────────────────────
         WHAT WAS WRONG, MEASURED BY THE IS-P01 PRODUCT AUDIT:

         This manifest declared NO permissions at all. `INTERNET` existed only
         in the debug/ and profile/ manifests, which Flutter generates and
         which are NOT merged into release builds. Every AI call
         (GroqModelProvider), every capability HTTP request (HttpCapability)
         and every knowledge fetch (WebWeaveXAdapter) would have failed
         silently in a shipped build.

         Each permission below is required by a dependency the project
         already declares in pubspec.yaml. Nothing speculative is requested —
         a permission with no caller is an unexplained Play review question. -->

    <!-- GroqModelProvider, HttpCapability, WebWeaveXAdapter, SearchProvider. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Fail fast and offline-aware rather than hanging on a dead socket. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- POST_NOTIFICATIONS WAS REMOVED IN IS-P04, AND THE IS-P01 COMMENT THAT
         JUSTIFIED IT WAS WRONG.
         
         It claimed RealNotificationService required it. Verified in IS-P04:
         `pubspec.yaml` declares NO notification plugin (no
         flutter_local_notifications, no awesome_notifications), and
         `lib/capabilities/adapters/notification_service_adapter.dart` delivers
         IN-APP ONLY: it publishes a NotificationGenerated event on the
         existing EventBus. There is no path to the Android notification
         system anywhere in this repository.
         
         A permission requested for a capability that does not exist is an
         unexplained question at Play review and an inconsistency against the
         Data Safety form. Re-add it in the same change that adds a real
         notification plugin, and not before. -->

    <!-- speech_to_text, via lib/services/voice_service.dart, which is
         REACHABLE (imported by home_screen.dart) and genuinely requests the
         permission at runtime: `Permission.microphone.request()` at line 67.
         Verified in IS-P04, correcting an IS-P03 triage entry that claimed no
         reachable request existed.
         
         `record` was also cited here and has been REMOVED from pubspec.yaml:
         it was imported by no file in lib/, test/ or examples/. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="Anything"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
