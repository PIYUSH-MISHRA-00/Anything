# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Local automation tool config (machine-local; mimocode.json contains a
# live API key and must never be committed)
.mimocode/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/

# ── Release signing (IS-P01) ───────────────────────────────────────────────
# A release keystore is UNRECOVERABLE if lost and grants publishing authority
# if leaked. Never commit either the keystore or the properties file that
# names its passwords. CI already fails the build if any of these are tracked
# (.github/workflows/ci.yml → "Confirm no forbidden files are tracked").
android/key.properties
*.jks
*.keystore
.env

# ── Website (IS-P02) ───────────────────────────────────────────────────────
website/node_modules/
website/docs/.vitepress/dist/
website/docs/.vitepress/cache/

# ── Local reports (kept on Desktop, not committed) ──────────────────────────
Desktop/
